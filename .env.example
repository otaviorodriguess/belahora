# Opcional: fuso do espaço. A agenda local não exige Google nem chaves de API.
VITE_TIME_ZONE=America/Sao_Paulo

# Login opcional. true exige configuração completa; false mantém o modo local legado.
VITE_AUTH_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Apenas desenvolvimento, com projeto demo- e servidor local:
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Ativar somente após configurar banco, regras, servidor e App Check.
VITE_CLOUD_AGENDA_ENABLED=false
VITE_PUBLIC_BOOKING_ORIGIN=https://agenda-estetica-phi.vercel.app
VITE_APPCHECK_SITE_KEY=
# Servidor apenas (sem prefixo VITE_; configurar na Vercel, nunca no código):
# FIREBASE_SERVICE_ACCOUNT_JSON=<JSON da credencial, salvo somente em ambiente seguro>
# BOOKING_RATE_SECRET=<segredo aleatório para anonimizar origens no limitador>
# Testes locais, nunca produção:
# VITE_FIRESTORE_EMULATOR=true
