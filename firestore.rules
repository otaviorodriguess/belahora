rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /accounts/{uid} {
   allow read: if request.auth != null && request.auth.uid == uid;
   allow write: if false;
   match /appointments/{id} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
   match /imports/{batch}/items/{id} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
   match /imports/{batch} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
