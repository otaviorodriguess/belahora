{
  "name": "aura-agenda-estetica",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  },
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc -b && npm run typecheck:server && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:local": "node scripts/test-local.mjs",
    "test:auth": "firebase emulators:exec --only auth --project demo-belahora \"playwright test --config playwright.auth.config.ts\"",
    "test:auth:pwa": "firebase emulators:exec --only auth --project demo-belahora \"playwright test --config playwright.auth-pwa.config.ts\"",
    "icons": "node scripts/icons.mjs",
    "test:cloud": "firebase emulators:exec --only auth,firestore --project demo-belahora \"vitest run --config vitest.server.config.ts\"",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:booking": "firebase emulators:exec --only auth,firestore --project demo-belahora \"playwright test --config playwright.booking.config.ts\"",
    "test:server:runtime": "node --no-experimental-require-module scripts/test-server-runtime.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/node": "^23.0.1",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.33.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
